// scatter_cull.comp
#version 460 core

// Drops items out of view and picks each other item's mesh by distance: the first
// LOD it is within, else the kind's impostor up to its distance, else nothing. In
// a LOD's crossfade band the next mesh is drawn too. A drawn item is appended to
// its mesh's part of the visible list and counted in that mesh's draw command.
// One workgroup per patch.

#include "scatter_data.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = SCATTER_ITEM_BINDING) readonly buffer ScatterItemBuffer {
    ScatterItem items[];
};
layout(std430, binding = SCATTER_COUNT_BINDING) readonly buffer ScatterCountBuffer {
    uint counts[];
};
layout(std430, binding = SCATTER_INSTANCE_BINDING) readonly buffer ScatterInstanceBuffer {
    ScatterInstanceData instances[];
};
layout(std430, binding = SCATTER_PATCH_BINDING) readonly buffer ScatterPatchBuffer {
    ScatterPatchData patches[];
};
layout(std430, binding = SCATTER_KIND_BINDING) readonly buffer ScatterKindBuffer {
    ScatterKindData kinds[];
};
layout(std430, binding = SCATTER_LOD_DISTANCE_BINDING) readonly buffer ScatterLodDistanceBuffer {
    vec2 lodDistances[];
};
layout(std430, binding = SCATTER_COMMAND_BINDING) buffer ScatterCommandBuffer {
    ScatterDrawCommand commands[];
};
layout(std430, binding = SCATTER_VISIBLE_BINDING) writeonly buffer ScatterVisibleBuffer {
    uvec2 visible[];
};

uniform uint u_itemsPerPatch;
uniform uint u_kindCount;

uniform mat4 view;
uniform mat4 projection;

void appendVisible(uint mesh, uint itemIndex, uint patchIndex) {
    const uint place = atomicAdd(commands[mesh].instanceCount, 1u);
    visible[commands[mesh].baseInstance + place] = uvec2(itemIndex, patchIndex);
}

// False when the sphere, camera relative in the world, lies wholly outside one of
// the view's side planes. They meet at the camera, so this drops what is behind.
bool inView(vec3 centre, float radius) {
    const mat4 toClip = projection * view;
    const vec4 clip = toClip * vec4(centre, 1.0);
    const vec4 rowX = vec4(toClip[0][0], toClip[1][0], toClip[2][0], toClip[3][0]);
    const vec4 rowY = vec4(toClip[0][1], toClip[1][1], toClip[2][1], toClip[3][1]);
    const vec4 rowW = vec4(toClip[0][3], toClip[1][3], toClip[2][3], toClip[3][3]);
    return clip.w + clip.x >= -radius * length((rowW + rowX).xyz) &&
           clip.w - clip.x >= -radius * length((rowW - rowX).xyz) &&
           clip.w + clip.y >= -radius * length((rowW + rowY).xyz) &&
           clip.w - clip.y >= -radius * length((rowW - rowY).xyz);
}

void main() {
    const uint patchIndex = gl_WorkGroupID.x;
    const ScatterPatchData patchData = patches[patchIndex];
    const vec3 bodyScale = instances[patchData.instance].bodyScale.xyz;
    const uint itemCount = counts[patchData.slot];

    for (uint local = gl_LocalInvocationID.x; local < itemCount; local += gl_WorkGroupSize.x) {
        const uint itemIndex = patchData.slot * u_itemsPerPatch + local;
        const ScatterItem item = items[itemIndex];
        // A snippet may name a kind the set lacks
        if (item.kind >= u_kindCount) continue;
        const ScatterKindData kind = kinds[item.kind];

        // In real metres, like the LOD distances
        const vec3 fromCamera = (patchData.cameraOffset + item.positionScale.xyz) * bodyScale;
        const float distance =
            scatterItemDistance(patchData.cameraOffset, item.positionScale.xyz, bodyScale);
        const float largestScale = max(bodyScale.x, max(bodyScale.y, bodyScale.z));
        if (!inView(instances[patchData.instance].bodyRotation * fromCamera,
                    kind.boundingRadius * item.positionScale.w * largestScale)) {
            continue;
        }

        uint lod = 0u;
        while (lod < kind.lodCount && distance > lodDistances[kind.firstMesh + lod].x) {
            ++lod;
        }

        if (lod < kind.lodCount) {
            const uint mesh = kind.firstMesh + lod;
            appendVisible(mesh, itemIndex, patchIndex);
            if (scatterHandover(lodDistances[mesh], distance) <= 0.0) continue;
            ++lod;
        }
        if (lod < kind.lodCount) {
            appendVisible(kind.firstMesh + lod, itemIndex, patchIndex);
        } else if (kind.impostorMesh != SCATTER_NO_MESH &&
                   distance <= lodDistances[kind.impostorMesh].x) {
            appendVisible(kind.impostorMesh, itemIndex, patchIndex);
        }
    }
}
